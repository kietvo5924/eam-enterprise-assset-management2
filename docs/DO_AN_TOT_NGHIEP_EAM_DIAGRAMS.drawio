        <mxCell id="cell_30" value="4. Trả về tập ứng viên hợp lệ trong đơn vị thuê" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=34;fontColor=#000000;labelBackgroundColor=#ffffff;endArrow=classic;dashed=1;endSize=12;" parent="1" edge="1">
