        <mxCell id="cell_4" value="&lt;b&gt;Lớp 1: Xác thực danh tính&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
