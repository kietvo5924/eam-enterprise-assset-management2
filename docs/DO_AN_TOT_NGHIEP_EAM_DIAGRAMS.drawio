        <mxCell id="cell_9" value="&lt;div style=&quot;font-size: 26px; line-height: 195px; text-align: center;&quot;&gt;HasPermission đối chiếu mã quyền&lt;br/&gt;của View với tập quyền thuộc&lt;br/&gt;vai trò Role của người dùng&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=26;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
