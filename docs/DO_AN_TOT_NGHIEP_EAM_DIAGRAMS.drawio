        <mxCell id="cell_14" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Khởi tạo phiếu&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Sinh lệnh công tác,&lt;br/&gt;kiểm tra tồn kho vật tư&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
