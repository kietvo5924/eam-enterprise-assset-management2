        <mxCell id="cell_7" value="&lt;div style=&quot;font-size: 26px; line-height: 195px; text-align: center;&quot;&gt;TenantMiddleware bóc tách&lt;br/&gt;thuộc tính tenant_id từ thẻ bài&lt;br/&gt;Ngăn chặn giả mạo tiêu đề HTTP&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=26;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
