        <mxCell id="cell_27" value="1. Yêu cầu phân công tự động danh sách lệnh công tác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=34;fontColor=#000000;labelBackgroundColor=#ffffff;endArrow=classic;endSize=12;" parent="1" edge="1">
