        <mxCell id="cell_5" value="&lt;div style=&quot;font-size: 26px; line-height: 195px; text-align: center;&quot;&gt;Kiểm tra chữ ký số thẻ bài JWT&lt;br/&gt;Xác minh thời hạn hiệu lực&lt;br/&gt;Trích xuất định danh người dùng&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=26;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
