  <diagram id="page-1" name="Sơ đồ 3.1 - Sơ đồ ngữ cảnh EAM">
    <mxGraphModel dx="2844" dy="1735" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2844" pageHeight="1735" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cell_2" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Dịch vụ thông báo đa kênh&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Thông báo đẩy FCM, thư điện tử và cảnh&lt;br/&gt;báo nội bộ&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="1054" y="84" width="737" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cell_3" value="&lt;b&gt;NỀN TẢNG QUẢN LÝ TÀI SẢN DOANH NGHIỆP EAM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=5.5;fontFamily=Arial;fontSize=32;fontColor=#000000;align=center;verticalAlign=top;spacingTop=32;" parent="1" vertex="1">
          <mxGeometry x="796" y="359" width="1253" height="994" as="geometry" />
        </mxCell>
        <mxCell id="cell_4" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Quản lý tài sản và cấu trúc vị trí&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Phân cấp cây tài sản, mặt bằng không gian, hồ sơ thiết bị&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="868" y="458" width="1108" height="166" as="geometry" />
        </mxCell>
        <mxCell id="cell_5" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Quản lý bảo trì và lệnh công tác&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Vòng đời phiếu công tác, kế hoạch phòng ngừa, danh mục kiểm tra&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="868" y="666" width="1108" height="166" as="geometry" />
        </mxCell>
        <mxCell id="cell_6" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Điều phối nguồn lực và tối ưu phân công&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Giải thuật Kuhn-Munkres, giải thuật di truyền NSGA-II, định tuyến TSP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="868" y="874" width="1108" height="166" as="geometry" />
        </mxCell>
        <mxCell id="cell_7" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Giám sát tình trạng và trí tuệ nhân tạo&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Phát hiện bất thường ISO 10816, dự báo tuổi thọ RUL, trợ lý kỹ thuật RAG&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="868" y="1082" width="1108" height="166" as="geometry" />
        </mxCell>
        <mxCell id="cell_8" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Quản trị viên và Quản lý&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Cổng điều hành Web Portal&lt;br/&gt;Lập kế hoạch, duyệt phiếu,&lt;br/&gt;KPI&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="80" y="706" width="534" height="278" as="geometry" />
        </mxCell>
        <mxCell id="cell_9" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;Kỹ thuật viên hiện&lt;br/&gt;trường&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Ứng dụng di động Flutter&lt;br/&gt;Quét QR, kiểm định, ngoại&lt;br/&gt;tuyến&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="2230" y="706" width="534" height="278" as="geometry" />
