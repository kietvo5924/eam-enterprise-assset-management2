        <mxCell id="cell_12" value="&lt;b&gt;VÒNG LẶP ĐIỀU HÀNH BẢO TRÌ KHÉP KÍN TRONG HỆ THỐNG EAM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=5.5;dashed=1;fontFamily=Arial;fontSize=32;fontColor=#000000;align=center;verticalAlign=top;spacingTop=45;" parent="1" vertex="1">
