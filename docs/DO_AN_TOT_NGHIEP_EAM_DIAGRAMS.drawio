        <mxCell id="cell_29" value="3. Truy vấn hồ sơ kỹ năng, chứng chỉ, ca trực và tọa độ thợ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=34;fontColor=#000000;labelBackgroundColor=#ffffff;endArrow=classic;endSize=12;" parent="1" edge="1">
