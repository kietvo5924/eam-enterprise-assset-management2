        </mxCell>
        <mxCell id="cell_8" value="&lt;b&gt;Lớp 3: Rào chắn quyền hạn&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
