  <diagram id="page-2" name="Sơ đồ 3.2 - Vòng đời tài sản &amp; bảo trì">
    <mxGraphModel dx="2890" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2890" pageHeight="1642" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cell_2" value="&lt;b&gt;CHU TRÌNH QUẢN LÝ VÒNG ĐỜI TÀI SẢN THIẾT BỊ CÔNG NGHIỆP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=5.5;fontFamily=Arial;fontSize=32;fontColor=#000000;align=center;verticalAlign=top;spacingTop=35;" parent="1" vertex="1">
          <mxGeometry x="105" y="105" width="2680" height="623" as="geometry" />
        </mxCell>
        <mxCell id="cell_3" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;1. Quy hoạch và Mua&lt;br/&gt;sắm&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Đăng ký danh mục,&lt;br/&gt;thiết lập cây phân cấp&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="163" y="244" width="465" height="392" as="geometry" />
        </mxCell>
        <mxCell id="cell_4" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;2. Lắp đặt và Định&lt;br/&gt;danh&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Gán vị trí mặt bằng,&lt;br/&gt;cấp mã QR và Beacon&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="690" y="244" width="465" height="392" as="geometry" />
        </mxCell>
        <mxCell id="cell_5" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;3. Vận hành và Giám&lt;br/&gt;sát&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Ghi nhận công tơ,&lt;br/&gt;giám sát rung chấn&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="1217" y="244" width="465" height="392" as="geometry" />
        </mxCell>
        <mxCell id="cell_6" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;4. Bảo trì và Phục&lt;br/&gt;hồi&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Bảo trì định kỳ PM,&lt;br/&gt;sửa chữa lệnh công tác&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="1743" y="244" width="465" height="392" as="geometry" />
        </mxCell>
        <mxCell id="cell_7" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;&lt;b&gt;5. Đánh giá và Thanh&lt;br/&gt;lý&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Phân tích chi phí QRF,&lt;br/&gt;thay thế thiết bị lỗi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.5;fontFamily=Arial;fontSize=28;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="2270" y="244" width="465" height="392" as="geometry" />
        </mxCell>
