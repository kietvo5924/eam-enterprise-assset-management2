        <mxCell id="cell_3" value="&lt;b&gt;CƠ CHẾ KIỂM SOÁT TRUY CẬP PHÂN TẦNG VÀ CÁCH LY DỮ LIỆU ĐA ĐƠN VỊ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=0;fontFamily=Arial;fontSize=32;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
